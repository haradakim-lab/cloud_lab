    function nextStep(step) {
        document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
        document.getElementById('step-' + step).classList.add('active');
        
        document.querySelectorAll('.step').forEach((el, idx) => {
            if(idx < step) el.classList.add('active');
            else el.classList.remove('active');
        });
        window.scrollTo(0,0);
        if(step === 5) initCanvas();
    }

    function execDaumPostcode() {
        new daum.Postcode({
            oncomplete: function(data) {
                document.getElementById('postalCode').value = data.zonecode;
                document.getElementById('baseAddress').value = data.roadAddress || data.jibunAddress;
                document.getElementById('detailAddress').focus();
            }
        }).open();
    }

    function handleProductChange(selectElement) {
        const selectedOption = selectElement.options[selectElement.selectedIndex];
        if(!selectedOption.value) return;

        currentData.productName = "구름채 " + selectedOption.value;
        currentData.basePrice = parseInt(selectedOption.getAttribute('data-price'));
        currentData.baseMonthly = parseInt(selectedOption.getAttribute('data-base-monthly'));

        document.getElementById('productPreviewBox').style.display = 'block';
        document.getElementById('previewTitle').innerText = currentData.productName;
        document.getElementById('previewPrice').innerText = `총 ${currentData.basePrice.toLocaleString()}원`;
        
        document.getElementById('previewDescList').innerHTML = `
            <li>${selectedOption.getAttribute('data-desc')}</li>
            <li>정상 월 납입금 약 ${currentData.baseMonthly.toLocaleString()}원 상당</li>
            <li>만기 완납 시 기납입금 100% 환급 적용</li>
        `;

        calculateSummary();
    }

    function calculateSummary() {
        if(!currentData.basePrice) return;

        let price = currentData.basePrice;
        let baseMonthly = currentData.baseMonthly;
        let discounts = [];

        let petCount = parseInt(document.getElementById('petCountSelect').value);
        let multiDiscountRate = 0;
        if(petCount >= 2) {
            multiDiscountRate = petCount;
            discounts.push(`다견 ${petCount}마리 (${multiDiscountRate}%)`);
        }

        let animalDisc = document.getElementById('discAnimal').checked;
        if(animalDisc) {
            discounts.push("동물등록 (1%)");
        }

        let promoDisc = document.getElementById('discPromo').checked;
        if(promoDisc) {
            discounts.push("현장 프로모션 60%(1년차 한정)");
        }

        let totalMultiplier = 1.0;
        if(animalDisc) totalMultiplier *= 0.99;
        if(multiDiscountRate > 0) totalMultiplier *= (1 - (multiDiscountRate / 100));
        
        let finalPriceCalculated = Math.round(price * totalMultiplier);
        let discountedMonthlyVal = Math.round(baseMonthly * totalMultiplier);

        if(promoDisc) {
            discountedMonthlyVal = Math.round(baseMonthly * (1 - 0.6));
            let annualBase = baseMonthly * 12;
            let promoSave = Math.round(annualBase * 0.6);
            finalPriceCalculated -= promoSave;
        }

        currentData.finalPrice = finalPriceCalculated;
        currentData.discountedMonthly = discountedMonthlyVal;
        currentData.discountText = discounts.length > 0 ? discounts.join(" + ") : "할인 없음";

        document.getElementById('sum-product').innerText = currentData.productName;
        document.getElementById('sum-price').innerText = currentData.basePrice.toLocaleString() + "원";
        document.getElementById('sum-monthly-discounted').innerText = currentData.discountedMonthly.toLocaleString() + "원 / 월";
        document.getElementById('sum-discount').innerText = currentData.discountText;
        document.getElementById('sum-final-price').innerText = currentData.finalPrice.toLocaleString() + "원";
    }

    function validateStep1() {
        const select = document.getElementById('productSelect');
        if(!select.value) {
